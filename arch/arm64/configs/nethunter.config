## Nethunter support config fragment

#
# General Setup
#

CONFIG_LOCALVERSION=""
CONFIG_DEFAULT_HOSTNAME="(kali)"
CONFIG_SYSVIPC=y

#
# Loadable Module Support
#

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y

#
# Networking Support - Bluetooth
#

CONFIG_BT_INTEL=m
CONFIG_BT_RTL=m
